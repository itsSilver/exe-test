{
	"name": "edison-cloud",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"typecheck": "nuxt typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:sql": "docker exec -it edison-cloud-firebird /usr/local/firebird/bin/isql -u SYSDBA -p masterkey /firebird/data/EDISONFDB_DATI.FDB"
	},
	"dependencies": {
		"@nuxt/ui": "^4.11.1",
		"@nuxtjs/i18n": "^10.6.0",
		"@nuxtjs/turnstile": "^1.1.3",
		"@pinia/nuxt": "^0.11.2",
		"@vueuse/nuxt": "^13.6.0",
		"gsap": "^3.15.0",
		"h3": "1.15.11",
		"node-firebird": "^2.16.2",
		"nuxt": "^4.5.2",
		"pinia": "^3.0.4",
		"vue": "^3.5.28",
		"vue-router": "^4.6.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.92",
		"@nuxt/eslint": "^1.9.0",
		"eslint": "^9.39.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.1",
		"vue-tsc": "^3.2.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"unrs-resolver",
			"vue-demi"
		]
	}
}
