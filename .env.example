# Secret used to sign the session cookie
SESSION_SECRET=change-me

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
