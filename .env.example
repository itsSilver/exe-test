# Firebird connection (matches docker-compose.yml)
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/firebird/data/EDISONFDB_DATI.FDB
FIREBIRD_USER=SYSDBA
