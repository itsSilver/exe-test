# Firebird connection (matches docker-compose.yml)
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/firebird/data/EDISONFDB_DATI.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey

# Secret used to sign the session cookie
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
